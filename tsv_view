#.begin-str help
# tsv_view - viewer for TSV files
# usage: tsv_view -h
#        tsv_view [OPTIONS] [files...]
# OPTIONS:
#   -h|--help     display this help
#   -l            replace \n with LF
#   -H            consider first line as header
#.end-str

BEGIN {
	FS = "\t"
	arg_n = getarg("l")
	arg_H = getarg("H")
}

arg_H && NR == 1 {
	max_col_len = 1
	for (i = 1; i <= NF; ++i) {
		col[i] = $i
		max_col_len = max(max_col_len, length($i))
	}
	col_fmt = sprintf("%%-%ds", max_col_len)
	next
}

{
	for (i=1; i <= NF; ++i){
		if (arg_n)
			gsub(/ \\n /, "\n", $i)

		if (arg_H)
			printf (col_fmt ": %s\n"), col[i], $i
		else
			print i, $i
	}
	print ""
}

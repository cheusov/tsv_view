#.begin-str help
# tsv_view - viewer for TSV files
# usage: tsv_view -h
#        tsv_view [OPTIONS] [files...]
# OPTIONS:
#   -h|--help         display this help
#   -l                replace \n with LF
#   -H                consider first line as header, if applied multiple times,
#                     headers are read from each input file
#   =d <delimiter>    sets regexp for delimiter, the default is \t
#   =o <columns>      comma-separated list of columns to output
#   =O <columns>      comma-separated list of columns to ignore
#
# Example:
#    tsv_view -HH bench1.tsv bench2.tsv
#
#.end-str

BEGIN {
	FS = getarg("d")
	if (FS == "") FS = "\t"
	arg_n = getarg("l")
	arg_H = getarg("H")
	col_fmt = "%-2s : %s\n"
	arg_o = getarg("o")
	arg_O = getarg("O")
	if (arg_o || arg_O) {
		split(arg_o arg_O, cols_idx, /,/)
		for (i in cols_idx) {
			cols[cols_idx[i]] = 1
		}
	}
}

arg_H && NR == 1 || arg_H > 1 && FNR == 1 {
	max_col_len = 1
	for (i = 1; i <= NF; ++i) {
		col[i] = $i
		max_col_len = max(max_col_len, length($i))
	}
	col_fmt = sprintf("%%-%ds: %%s\n", max_col_len + 1)
	next
}

{
	for (i=1; i <= NF; ++i){
		if (arg_n)
			gsub(/ \\n /, "\n", $i)

		if (arg_H)
			col_name = col[i]
		else
			col_name = i

		if (arg_o && !(col_name in cols)) continue
		if (arg_O && (col_name in cols)) continue

		printf col_fmt, col_name, $i
	}
	print ""
}
